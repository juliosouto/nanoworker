
QWEN_MODEL=qwen-plus
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_PREF_1=gemini-3.1-flash-lite
LLM_PREF_2=gemini-3.5-flash
LLM_PREF_3=gemini-3-flash-preview
LLM_PREF_4=gemma-4-31b-it
LLM_PREF_5=gemma-4-26b-a4b-it

# --- LangChain integration (agent.lc) ---
# LLM execution stack: 'langchain' (default since Fase 6) or 'legacy' (the
# pre-LangChain provider loops, kept for one release as a rollback hatch).
LLM_STACK=langchain
# Token counter: 'tiktoken' (real BPE counting) or 'heuristic' (legacy 1 token ~= 4 chars).
LC_TOKEN_COUNTER=tiktoken
# Structured output (Fase 1): 'auto' (enforce the JSON contract natively when the
# provider supports it, omitting the prose schema block) or 'off' (legacy prompt).
LC_STRUCTURED_OUTPUT=auto
# Phase 2+: how many user memories are injected via RAG.
LC_MEMORY_TOP_K=5
# Phase 2: embeddings provider for the memory retriever (auto | gemini | openai).
# 'auto' inspects llm_config and picks the cheapest available provider
# (Gemini text-embedding-004 preferred, OpenAI text-embedding-3-small fallback).
LC_EMBEDDINGS_PROVIDER=auto
# Phase 4: character cap applied to tool results before they re-enter the context.
LC_TOOL_RESULT_MAX_CHARS=6000
# Phase 4: use compact tool schemas (first-line descriptions instead of the full
# docstring; biggest win in the Gemini loop). Toggle: on | off.
LC_TOOL_COMPACT_SCHEMA=on
# Phase 3: number of recent conversation messages kept verbatim during summarization.
LC_KEEP_RECENT_MSGS=8
# Phase 5: LangChain SQLite LLM cache. Off by default (set_llm_cache installs a
# process-global cache affecting every chat model). Toggle: true | false.
LC_CACHE=false
# Phase 5: file used by the SQLite LLM cache when LC_CACHE=true.
#LC_CACHE_PATH=llm_cache.sqlite
# --- Advanced Settings: Tool Relevance Filter (agent.lc) ---
# Opt-in. When 'true', ONE lightweight LangChain call narrows the permitted
# tool set to the tools likely needed by the user's message before the main
# provider call (saves tokens, reduces tool confusion for small models).
# Fail-open: on any error the full tool set is sent. Default is 'false'.
# NOTE: the env var wins over the Advanced Settings toggle AND the UI mirrors
# it, so pinning it here also renders the switch as ON in /settings/advanced.
# Recommended for cloud deploys where the SQLite settings row is not
# guaranteed to survive container recreations. Left commented out by default
# so the UI toggle stays fully functional for local installs.
#TOOL_RELEVANCE_FILTER=false
# Fase 6: LangSmith tracing (optional, zero code — langchain-core picks these
# up from the environment and only traces the LangChain execution stack).
# NOTE: the flag is TRACING (not "TRADING").
#LANGCHAIN_TRACING_V2=true
#LANGSMITH_API_KEY=
#LANGSMITH_PROJECT=nanoworker
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com
